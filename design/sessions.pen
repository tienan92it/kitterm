                  "textGrowth": "fixed-width",
                  "width": 68,
                  "textAlign": "right",
                  "fontFamily": "$mono",
                  "fontSize": "$type-body",
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "pgt7R",
          "name": "Rules",
          "width": "fill_container",
          "stroke": "$border",
          "strokeWidth": {
            "top": 1
          },
          "strokeAlignment": "inner",
          "layout": "vertical",
          "padding": [
            "$space-3",
            0,
            0,
            0
          ],
          "children": [
            {
              "type": "frame",
              "id": "CQrd6",
              "name": "section head",
              "height": 28,
              "gap": "$space-3",
              "alignItems": "center",
              "children": [
                {
                  "type": "text",
                  "id": "fHkdd",
                  "name": "t",
                  "fill": "$text",
                  "content": "Rules",
                  "fontFamily": "$mono",
                  "fontSize": "$type-heading",
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "Ukxlh",
                  "name": "t",
                  "fill": "$faint",
                  "fontFamily": "$mono",
                  "fontSize": "$type-body",
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "EYZQo",
              "name": "rule",
              "height": 24,
              "alignItems": "center",
              "children": [
                {
                  "type": "text",
                  "id": "xSQXB",
                  "name": "t",
                  "fill": "$muted",
                  "content": "1. One status cell per line, at one x on every level: a mark and a bracketed word. The colour is on the mark alone.",
                  "fontFamily": "$mono",
                  "fontSize": "$type-body",
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "CKWVS",
              "name": "rule",
              "height": 24,
              "alignItems": "center",
              "children": [
                {
                  "type": "text",
                  "id": "O4aEB",
                  "name": "t",
                  "fill": "$muted",
                  "content": "2. Stage marks: • plan (grey), ◐ build (accent, turns), ? review (amber), ? blocked on a person (amber), ! blocked by a failure (red), ✓ done (green).",
                  "fontFamily": "$mono",
                  "fontSize": "$type-body",
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "B8k6mX",
              "name": "rule",
              "height": 24,
              "alignItems": "center",
              "children": [
                {
                  "type": "text",
                  "id": "SgsVE",
                  "name": "t",
                  "fill": "$muted",
                  "content": "3. Order in a list: blocked, review, build, plan, done. A blocked or a review line prints how long it waits in the last column.",
                  "fontFamily": "$mono",
                  "fontSize": "$type-body",
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "bYbqi",
              "name": "rule",
              "height": 24,
              "alignItems": "center",
              "children": [
                {
                  "type": "text",
                  "id": "PA6cq",
                  "name": "t",
                  "fill": "$muted",
                  "content": "4. Hairline joins tie a child to its parent. The left column holds the joins and the disclosure triangle, and no state mark.",
                  "fontFamily": "$mono",
                  "fontSize": "$type-body",
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "JaF6m",
              "name": "rule",
              "height": 24,
              "alignItems": "center",
              "children": [
                {
                  "type": "text",
                  "id": "pzldB",
                  "name": "t",
                  "fill": "$muted",
                  "content": "5. A session whose cwd is the workspace directory sits under the workspace line (the foreman of that scope).",
                  "fontFamily": "$mono",
                  "fontSize": "$type-body",
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "maRpF",
              "name": "rule",
              "height": 24,
              "alignItems": "center",
              "children": [
                {
                  "type": "text",
                  "id": "x514n",
                  "name": "t",
                  "fill": "$muted",
                  "content": "6. A project with every goal done and no live session starts closed, with its count: 10 done. A goal with no open task starts closed.",
                  "fontFamily": "$mono",
                  "fontSize": "$type-body",
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "ryrtA",
              "name": "rule",
              "height": 24,
              "alignItems": "center",
              "children": [
                {
                  "type": "text",
                  "id": "nU2IR",
                  "name": "t",
                  "fill": "$muted",
                  "content": "7. Phone: joins, name, status cell, #N and one state word (draft, CI ✓, CI ✗, CI …, merged). The purpose, the cost and the time drop.",
                  "fontFamily": "$mono",
                  "fontSize": "$type-body",
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
