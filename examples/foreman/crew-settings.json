{
  "permissions": {
    "deny": [
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "Bash(kitterm start)",
      "Bash(kitterm start *)",
      "Bash(kitterm stop)",
      "Bash(kitterm stop *)",
      "Bash(kitterm restart)",
      "Bash(kitterm restart *)",
      "Edit(//**/.github/workflows/**)",
      "Edit(//**/docs/goals/*/goal.md)",
      "Edit(//**/docs/goals/*/corpus/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "kitterm round guard || exit 2"
          }
        ]
      }
    ]
  }
}
