  "cards": [
    {
      "dot": "cyan",
      "title": "One process, no emulation",
      "items": [
        "The daemon never interprets screen state; xterm.js owns the grid",
        "OscMarkScanner is the one bounded exception: it indexes OSC 133/633 marks",
        "No Node on the hot path"
      ]
    },
    {
      "dot": "emerald",
      "title": "Durability",
      "items": [
        "Every output byte flows through a 4 MiB ring with absolute offsets",
        "A reconnect with ?since=<offset> replays exactly the missed bytes",
        "--retain-logs spills past the ring to ~/.kitterm/logs"
      ]
    },
    {
      "dot": "rose",
      "title": "Access",
      "items": [
        "Loopback is trusted; --lan and proxies require a token",
        "Watch tokens observe only: no input, no control, no spawn",
        "POST input exists only with --agent-control"
      ]
    }
  ]
