  "cards": [
    { "dot": "emerald", "title": "Absolute offsets", "items": ["Every output byte gets an absolute stream offset in the ring", "The client counts the bytes it received and remembers the offset", "Detached reads never pause; the ring rotates instead"] },
    { "dot": "amber", "title": "Detach, do not kill", "items": ["A dropped socket detaches the PTY; the shell keeps running", "The client auto-reconnects with backoff and on focus/online/visible", "An unreattached session is reaped after 5 minutes"] },
