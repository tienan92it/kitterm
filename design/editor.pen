                              "padding": [
                                0,
                                "$space-2",
                                0,
                                0
                              ],
                              "justifyContent": "end",
                              "alignItems": "center",
                              "children": [
                                {
                                  "type": "text",
                                  "id": "Alx2N",
                                  "name": "t",
                                  "fill": "$faint",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$mono",
